datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  CUSTOMER
  DISTRIBUTOR
}

enum DistributorStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum LedgerRequestStatus {
  REQUESTED
  FULFILLED
}

model Brand {
  id           String    @id @default(uuid())
  slug         String    @unique
  name         String
  tagline      String
  description  String
  logoUrl      String?
  heroImageUrl String?
  themeKey     String    // "nafi", "greek", "raksham"
  order        Int       @default(0)
  isActive     Boolean   @default(true)
  products     Product[]
  inquiries    Inquiry[]
  catalogs     Catalog[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Category {
  id       String    @id @default(uuid())
  slug     String    @unique
  name     String
  products Product[]
}

model Product {
  id               String         @id @default(uuid())
  slug             String         @unique
  name             String
  brandId          String
  brand            Brand          @relation(fields: [brandId], references: [id])
  categoryId       String
  category         Category       @relation(fields: [categoryId], references: [id])
  description      String
  material         String
  size             String
  finish           String
  numberOfKeys     Int            @default(0)
  lockingMechanism String
  warranty         String         @default("1 year")
  images           String[]       // Array of image URLs
  dealerPrice      Decimal?
  minOrderQty      Int?
  isActive         Boolean        @default(true)
  inquiries        Inquiry[]
  orderItems       OrderItem[]
  likedBy          LikedProduct[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Inquiry {
  id        String   @id @default(uuid())
  name      String
  company   String?
  email     String
  phone     String
  message   String
  brandId   String?
  brand     Brand?   @relation(fields: [brandId], references: [id])
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  status    String   @default("new") // "new" | "contacted" | "closed"
  createdAt DateTime @default(now())
}

model AdminUser {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String
  role         String @default("admin")
}

model User {
  id                 String              @id @default(uuid())
  name               String
  email              String              @unique
  passwordHash       String
  phone              String?
  role               UserRole
  createdAt          DateTime            @default(now())
  distributorProfile DistributorProfile?
  likedProducts      LikedProduct[]
  inquiries          Inquiry[]
  orders             Order[]
  ledgerRequests     LedgerRequest[]
  ledgers            Ledger[]
}

model DistributorProfile {
  id              String            @id @default(uuid())
  userId          String            @unique
  user            User              @relation(fields: [userId], references: [id])
  companyName     String
  gstNumber       String?
  businessAddress String
  city            String
  state           String
  status          DistributorStatus @default(PENDING)
  appliedAt       DateTime          @default(now())
  reviewedAt      DateTime?
  reviewedById    String?
  assignedRepId   String?
  assignedRep     SalesRep?         @relation(fields: [assignedRepId], references: [id])
}

model SalesRep {
  id                  String               @id @default(uuid())
  name                String
  email               String
  phone               String
  photoUrl            String?
  distributorProfiles DistributorProfile[]
}

model Order {
  id            String      @id @default(uuid())
  orderNumber   String      @unique
  distributorId String
  distributor   User        @relation(fields: [distributorId], references: [id])
  status        OrderStatus @default(PLACED)
  notes         String?
  placedAt      DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal
}

model LedgerRequest {
  id            String              @id @default(uuid())
  distributorId String
  distributor   User                @relation(fields: [distributorId], references: [id])
  note          String?
  status        LedgerRequestStatus @default(REQUESTED)
  requestedAt   DateTime            @default(now())
  fulfilledAt   DateTime?
}

model Ledger {
  id            String   @id @default(uuid())
  distributorId String
  distributor   User     @relation(fields: [distributorId], references: [id])
  requestId     String?
  title         String
  fileUrl       String
  uploadedById  String
  uploadedAt    DateTime @default(now())
}

model Catalog {
  id         String   @id @default(uuid())
  title      String
  fileUrl    String
  brandId    String?
  brand      Brand?   @relation(fields: [brandId], references: [id])
  uploadedAt DateTime @default(now())
}

model LikedProduct {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  likedAt   DateTime @default(now())

  @@unique([userId, productId])
}
